	(gr_text "FAB NOTES (full notes: FAB_NOTES.txt)\n1. 4-layer, 1.6 mm, FR-4 high-Tg. 2 oz outer / 1 oz inner copper. ENIG.\n2. VIA-IN-PAD: U8-U11 (KF1950, 51 each) and U2 (TPS546 pad, 15):\n    0.3 mm drill / 0.6 mm pad, epoxy filled, copper capped, planarised\n    (IPC-4761 Type VII). Filling all 0.3 mm vias is acceptable.\n3. Front solder mask is intentionally OPEN under the heatsink area,\n    including over the via caps (no tenting there). Do not add mask.\n4. Back mask opening under U2 is intentional.\n5. J1 / J9 share the same two holes on purpose."
		(at 98.5 153 0)
		(layer "Cmts.User")
		(uuid "c967bc0b-6476-4e5f-8b0a-3bc4a1ab1e63")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left top)
		)
	)
